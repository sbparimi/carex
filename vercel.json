{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.py": {
      "includeFiles": "carex/{templates,static}/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "regions": [
    "iad1"
  ],
  "git": {
    "deploymentEnabled": {
      "course/agentic-sdlc-api-automation": false
    }
  }
}
