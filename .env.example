# Copy to .env for local use (python -m carex.ops reads it), and set the same names in Vercel > Settings > Environment Variables.
# Never commit real values. .env is git-ignored.

# Database. Leave empty locally: a file named carex.db (SQLite) is used.
# Online: Neon POOLED connection string (host contains "-pooler"), sslmode=require, into an EMPTY database.
DATABASE_URL=

# Long random string. Enables POST /internal/dispatch, called every 10 minutes by .github/workflows/dispatch.yml.
CRON_SECRET=

# Public base URL used in email/SMS links. On Vercel it defaults to the production domain.
APP_BASE_URL=

# Optional email (https://resend.com). Without these, emails are skipped with a recorded reason.
RESEND_API_KEY=
# Just the address on a domain you verified in Resend. Each organisation's name is shown as the sender name, and replies go to its support email.
EMAIL_FROM=no-reply@your-verified-domain.example
# Where `python -m carex.ops email-test` sends. Until you verify a domain, Resend only delivers to your Resend account email.
EMAIL_TEST_TO=reachparimi@gmail.com

# Optional text messages (only people who opt in are texted).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Optional: sign in to the demo as this patient (an inbox you control) so booking/cancelling in the app sends you real emails.
DEMO_PATIENT_EMAIL=reachparimi@gmail.com
