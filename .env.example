# Copy to .env for local use, and set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values. .env is git-ignored.

# Neon: use the POOLED connection string (host contains "-pooler"), with sslmode=require.
DATABASE_URL=

# Local only: serve plain-HTTP cookies. Leave unset on Vercel (the Vercel entry always uses Secure cookies).
# CAREX_SECURE_COOKIES=1

# Password-reset email through Resend (https://resend.com). Without these, reset emails are NOT sent.
RESEND_API_KEY=
EMAIL_FROM="CareX <no-reply@your-verified-domain.example>"
# Public base URL used in email links. On Vercel it defaults to the production domain.
APP_BASE_URL=

# Development only, empty database only: load invented demo tenants and demo patients.
# CAREX_SEED_SYNTHETIC=1

# --- Notifications (optional; each channel is skipped, with a reason, when its variables are missing) ---
# APP_BASE_URL=https://your-app.vercel.app
# RESEND_API_KEY=            # email
# EMAIL_FROM="CareX <no-reply@your-domain>"
# TWILIO_ACCOUNT_SID=        # text messages (only people who opt in are texted)
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15555550100
# CRON_SECRET=               # long random string; enables POST /internal/dispatch for the 10-minute reminder job
