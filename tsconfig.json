{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@carex/contracts": [
        "packages/contracts/src/index.ts"
      ]
    },
    "baseUrl": "."
  },
  "baseUrl": ".",
  "paths": {
    "@carex/contracts": [
      "packages/contracts/src/index.ts"
    ]
  },
  "include": [
    "apps/api",
    "apps/web/test",
    "packages"
  ]
}