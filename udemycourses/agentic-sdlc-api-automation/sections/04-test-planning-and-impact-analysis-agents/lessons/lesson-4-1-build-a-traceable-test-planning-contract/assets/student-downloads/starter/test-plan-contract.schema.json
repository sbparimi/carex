{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CareX Traceable API Test Plan",
  "type": "object",
  "required": ["change_id", "source_revision", "contract_revision", "scenarios", "open_questions", "review"],
  "properties": {
    "change_id": {"const": "CAREX-CHANGE-030-CANCEL-24H"},
    "source_revision": {"type": "string", "minLength": 1},
    "contract_revision": {"type": "string", "minLength": 1},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["scenario_id", "rule_id", "actor", "preconditions", "scenario_class", "expected_business_outcome", "evidence_refs", "risk", "execution_status"],
        "properties": {
          "scenario_id": {"type": "string"},
          "rule_id": {"type": "string"},
          "actor": {"type": "string"},
          "preconditions": {"type": "array", "items": {"type": "string"}},
          "scenario_class": {"enum": ["positive", "negative", "boundary", "authorization", "regression", "idempotency", "state"]},
          "expected_business_outcome": {"type": "string"},
          "operation_ref": {"type": ["string", "null"]},
          "http_expectation": {"type": ["string", "null"], "description": "Keep null until pinned OpenAPI evidence supports it."},
          "evidence_refs": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "risk": {"enum": ["critical", "high", "medium", "low"]},
          "execution_status": {"enum": ["not_ready", "ready_after_contract_review", "executed"]}
        },
        "additionalProperties": false
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}},
    "review": {
      "type": "object",
      "required": ["reviewer", "decision", "rejected_assumptions"],
      "properties": {
        "reviewer": {"type": "string"},
        "decision": {"enum": ["approved_for_collection_design", "changes_required", "blocked"]},
        "rejected_assumptions": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "additionalProperties": false
}
