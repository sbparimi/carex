            "url": "{{baseUrl}}/t/{{tenant}}/api/v1/auth/signup"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "if (pm.response.code === 201 && pm.response.json().access_token) {",
                  "  pm.environment.set('patientToken', pm.response.json().access_token);",
                  "  pm.collectionVariables.set('patientToken', pm.response.json().access_token);",
                  "} else { throw new Error('Signup did not return an access token.'); }",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (String(pm.environment.get('runSignup') || 'false') !== 'true') { pm.execution.skipRequest(); }",
                  "{",
                  "pm.environment.unset('patientToken');",
                  "pm.collectionVariables.unset('patientToken');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test('HTTP contract: Patient signup',()=>pm.expect(pm.response.code).to.be.oneOf([201]));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Patient login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{patientEmail}}\",\"password\":\"{{patientPassword}}\"}"
            },
            "url": "{{baseUrl}}/t/{{tenant}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "if (pm.response.code === 200 && pm.response.json().access_token) {",
                  "  pm.environment.set('patientToken', pm.response.json().access_token);",
                  "  pm.collectionVariables.set('patientToken', pm.response.json().access_token);",
                  "} else if (pm.response.code === 202 && pm.response.json().mfa_required) {",
                  "  pm.environment.set('mfaChallenge', pm.response.json().challenge);",
                  "  pm.collectionVariables.set('mfaChallenge', pm.response.json().challenge);",
                  "} else { throw new Error('Login did not return an access token. Check credentials or complete MFA.'); }",
                  "}"
                ]
              }
            },
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.unset('mfaChallenge');pm.collectionVariables.unset('mfaChallenge');",
                  "{",
                  "pm.environment.unset('patientToken');",
                  "pm.collectionVariables.unset('patientToken');",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "{",
                  "pm.test('HTTP contract: Patient login',()=>pm.expect(pm.response.code).to.be.oneOf([200,202]));",
                  "}"
                ]
              }
            }
          ]
        },
