            "body": {
              "mode": "raw",
              "raw": "{\"email\":\"{{patientEmail}}\",\"password\":\"{{patientPassword}}\",\"first_name\":\"Course\",\"last_name\":\"Patient\",\"date_of_birth\":\"1990-02-03\",\"phone\":\"555-123-4567\",\"access_type\":\"employer\",\"access_id\":\"{{employerId}}\"}"
